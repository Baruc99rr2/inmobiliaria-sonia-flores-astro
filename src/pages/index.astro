---
import Layout from '../layouts/Layout.astro';
import AppWrapper from '../components/AppWrapper.jsx';
import Homepage from '../components/Homepage.jsx';
import LoadingScreen from '../components/LoadingScreen.jsx';
import { getPublishedProducts, CACHE_CONTROL } from '../lib/properties';

// Fase 3: la página pasa a renderizarse por request para leer de Supabase.
export const prerender = false;

// Si la consulta falla, `products` queda null y los componentes caen al
// fallback de data.jsx. El sitio nunca se queda sin propiedades.
const products = await getPublishedProducts();

// Si estamos sirviendo el fallback de data.jsx, no dejamos que el CDN cachee 60
// segundos una respuesta degradada: en cuanto Supabase vuelva, queremos el dato
// bueno.
Astro.response.headers.set(
  'Cache-Control',
  products ? CACHE_CONTROL : 'public, max-age=0, must-revalidate'
);

const siteOrigin = Astro.url.origin;
const currentUrl = Astro.url.href;
const absoluteLogoUrl = `${siteOrigin}/SoniaLogo.png`;
const title = "Inmobiliaria Sonia Flores | Propiedades en Jujuy";
const description = "Encontrá tu próximo hogar en San Salvador de Jujuy. Alquiler y venta de casas, departamentos, terrenos y locales comerciales. Martillera Sonia Flores MP 177.";
---

<Layout
  title={title}
  description={description}
  image={absoluteLogoUrl}
>
  <AppWrapper client:load>
    <LoadingScreen client:load />
    <Homepage client:load products={products} />
  </AppWrapper>
</Layout>
