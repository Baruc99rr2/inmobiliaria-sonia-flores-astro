---
import Layout from '../layouts/Layout.astro';
import AppWrapper from '../components/AppWrapper.jsx';
import Busqueda from '../components/Busqueda/Busqueda.jsx';
import { getPublishedProducts, getCatalogos, CACHE_CONTROL } from '../lib/properties';

// Fase 3: la página pasa a renderizarse por request para leer de Supabase.
export const prerender = false;

// Los catálogos alimentan los <select> de localidad, barrio y tipo. Antes las
// listas estaban hardcodeadas —y eran distintas entre desktop y mobile—, que es
// lo que hacía que el filtro de barrio no matcheara nunca.
const [products, catalogos] = await Promise.all([
  getPublishedProducts(),
  getCatalogos(),
]);

// Si estamos sirviendo el fallback de data.jsx, no dejamos que el CDN cachee 60
// segundos una respuesta degradada.
Astro.response.headers.set(
  'Cache-Control',
  products ? CACHE_CONTROL : 'public, max-age=0, must-revalidate'
);

const title = "Búsqueda de Propiedades - Inmobiliaria Sonia Flores";
const description = "Encontrá casas, departamentos, terrenos y locales comerciales en San Salvador de Jujuy. Filtrá por precio, barrio y tipo de propiedad.";
---

<Layout title={title} description={description}>
  <AppWrapper client:load>
    <Busqueda client:only="react" products={products} catalogos={catalogos} />
  </AppWrapper>
</Layout>
