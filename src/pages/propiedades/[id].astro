---
import Layout from '../../layouts/Layout.astro';
import ProductDetailsReact from '../../components/ProductDetailsReact.jsx';
import PropiedadNoEncontrada from '../../components/PropiedadNoEncontrada.astro';
import ProblemaTecnico from '../../components/ProblemaTecnico.astro';
import {
  getProductPorCodigo,
  CACHE_CONTROL,
  HEADER_ORIGEN,
  ORIGEN_SUPABASE,
  ORIGEN_FALLBACK,
} from '../../lib/properties';
import { productsData } from '../../data';
import { getConfiguracionSitio } from '../../lib/configuracion-sitio-server';

// Fase 3: se cae `getStaticPaths`. Antes generaba 18 páginas fijas en el build,
// así que una propiedad nueva cargada desde el panel no iba a existir hasta el
// próximo deploy. Ahora la ruta se resuelve por request contra Supabase.
export const prerender = false;

const { id } = Astro.params;
const codigo = Number(id);
const idValido = Number.isInteger(codigo) && codigo > 0;

const resultado = idValido
  ? await getProductPorCodigo(codigo)
  : { ok: true, product: null };

// Si la consulta falló (Supabase caído, red, RLS) NO devolvemos 404: eso le
// diría al buscador que la propiedad dejó de existir. Caemos a data.jsx, igual
// que el home y la búsqueda. El 404 queda reservado para cuando la consulta
// anduvo y la propiedad realmente no está.
const product = resultado.ok
  ? resultado.product
  : (productsData.find((p) => p.id === codigo) ?? null);

const desdeFallback = !resultado.ok && product !== null;

/**
 * TRES desenlaces distintos, no dos.
 *
 *   1. La consulta anduvo y la propiedad no está  -> 404 de verdad.
 *   2. La consulta falló y el fallback la tiene   -> se sirve del fallback.
 *   3. La consulta falló y el fallback NO la tiene -> NO SABEMOS si existe.
 *
 * El caso 3 es el que faltaba y terminaba en 404. Pasa con cualquier propiedad
 * cargada desde el panel después de que se congeló `data.jsx`: si Supabase se
 * cae, el fallback no la tiene. Contestar 404 ahí le dice al buscador que
 * desindexe una ficha que está perfecta, y recuperar posicionamiento cuesta
 * semanas para un problema que dura minutos.
 */
const problemaTecnico = !resultado.ok && product === null;

// Fase 6.6: los datos de contacto salen de la base, no del codigo.
const configuracion = await getConfiguracionSitio();

const siteOrigin = Astro.url.origin;
const currentUrl = Astro.url.href;

// Vercel normaliza el Cache-Control; este header no. Ver properties.ts.
Astro.response.headers.set(HEADER_ORIGEN, desdeFallback ? ORIGEN_FALLBACK : ORIGEN_SUPABASE);

if (product) {
  // Si estamos sirviendo el fallback, no dejamos que el CDN cachee 60 segundos
  // una respuesta degradada: en cuanto Supabase vuelva, queremos el dato bueno.
  Astro.response.headers.set(
    'Cache-Control',
    desdeFallback ? 'public, max-age=0, must-revalidate' : CACHE_CONTROL
  );
} else if (problemaTecnico) {
  // 503 y no 404: "volvé más tarde", no "esto no existe". Es la respuesta que
  // la documentación de Google indica para indisponibilidad temporal, y la
  // única que no toca el índice.
  Astro.response.status = 503;
  // `Retry-After` en segundos. 120 es suficiente para un reinicio y lo bastante
  // corto para que el buscador vuelva a probar pronto.
  Astro.response.headers.set('Retry-After', '120');
  // Que NADIE cachee una respuesta de error: ni el CDN ni el browser. Si no, la
  // caída se sigue sirviendo después de que Supabase volvió.
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  // Antes esto hacía `Astro.redirect('/404')`, una ruta que NO existía: el
  // visitante terminaba en una página inexistente y el buscador recibía un 302
  // en vez de un 404. Ahora se responde 404 de verdad, en la misma URL.
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
}

// Metadatos solo para el caso con propiedad.
const imagesList = product?.images ?? [];
const mainImageRaw = imagesList[0];
const mainImage = mainImageRaw
  ? (mainImageRaw.startsWith('http') ? mainImageRaw : `${siteOrigin}${mainImageRaw}`)
  : `${siteOrigin}/SoniaLogo.png`;
---

{
  product ? (
    <Layout
      title={`${product.name} - ${product.detalles?.barrio || 'Jujuy'}`}
      description={product.description}
      image={mainImage}
    >
      <ProductDetailsReact
        client:only="react"
        product={product}
        currentUrl={currentUrl}
        configuracion={configuracion}
      />
    </Layout>
  ) : problemaTecnico ? (
    <Layout
      title="Estamos con problemas técnicos | Inmobiliaria Sonia Flores"
      description="No pudimos cargar esta propiedad en este momento. Probá de nuevo en unos minutos."
    >
      <ProblemaTecnico />
    </Layout>
  ) : (
    <Layout
      title="Propiedad no encontrada | Inmobiliaria Sonia Flores"
      description="La propiedad que buscás no está disponible. Mirá el resto de nuestras propiedades en alquiler y venta en San Salvador de Jujuy."
    >
      <PropiedadNoEncontrada />
    </Layout>
  )
}
