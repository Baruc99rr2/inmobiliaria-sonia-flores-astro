---
/**
 * Bloque compartido por `/404` y por `/propiedades/[id]` cuando el id no existe
 * o la propiedad no está publicada.
 *
 * Hasta la Fase 3 no había ninguna página 404: `[id].astro` redirigía a `/404`,
 * una ruta inexistente.
 */
interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = 'No encontramos esta propiedad',
  texto = 'Puede que ya se haya alquilado o vendido, o que el enlace esté mal escrito.',
} = Astro.props;
---

<section class="min-h-[70vh] flex items-center justify-center px-6 py-24 bg-gray-50">
  <div class="max-w-xl w-full text-center">
    <p class="text-6xl sm:text-7xl font-black text-[#d64531] leading-none select-none">404</p>

    <h1 class="mt-6 text-2xl sm:text-3xl font-black text-gray-900">{titulo}</h1>
    <p class="mt-3 text-base text-gray-600 leading-relaxed">{texto}</p>

    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/busqueda"
        class="bg-[#d64531] hover:bg-red-700 text-white font-bold text-sm uppercase tracking-wide px-6 py-3.5 rounded-xl transition-colors"
      >
        Ver todas las propiedades
      </a>
      <a
        href="/"
        class="bg-white hover:bg-gray-100 text-gray-800 border border-gray-200 font-bold text-sm uppercase tracking-wide px-6 py-3.5 rounded-xl transition-colors"
      >
        Ir al inicio
      </a>
    </div>

    <p class="mt-8 text-sm text-gray-500">
      ¿Buscabas algo en particular? Escribinos al
      <a href="tel:+5438854881245" class="text-[#d64531] font-semibold hover:underline">388 54881245</a>,
      de 9 a 13 y de 16 a 18 hs.
    </p>
  </div>
</section>
