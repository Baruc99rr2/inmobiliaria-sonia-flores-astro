# Copiar a .env y completar. El .env real esta en .gitignore y no se versiona.

# ---------------------------------------------------------------------------
# Web3Forms - formulario de contacto del footer (Fase 0.6)
# ---------------------------------------------------------------------------
# Solucion puente: se retira entera en la Fase 8.5, cuando el formulario pase a
# escribir en la tabla contact_messages de Supabase.
#
# La access key es PUBLICA por diseno. Web3Forms lo documenta de forma explicita
# ("The Access Key is not a secret API Key. It can be Public and it's safe to use
# it"), y viaja dentro del bundle del cliente. El prefijo PUBLIC_ es lo que hace
# que Astro la exponga al browser: sin ese prefijo, el formulario no funciona.
#
# El DESTINATARIO de las consultas NO se configura aca: esta atado a la access
# key y se cambia desde el panel de Web3Forms. Hoy apunta a baruc276@gmail.com.
#
# >>> IMPORTANTE <<<
# Esta variable hay que cargarla TAMBIEN en Vercel:
#   Project Settings > Environment Variables > PUBLIC_WEB3FORMS_ACCESS_KEY
# aplicandola a Production, Preview y Development.
# Si falta en Vercel, el formulario anda en local y FALLA en produccion. El
# codigo detecta la key ausente y muestra un error con el telefono en vez de
# fingir un envio exitoso, pero igual no se envia nada.
# >>> YA NO SE USA (Fase 8.5) <<<
# El formulario de contacto ahora escribe en la tabla contact_messages de
# Supabase y la duena lee los mensajes desde el panel. Web3Forms quedo fuera.
# La variable se deja documentada y SIN BORRAR por si hay que volver atras
# rapido; el codigo ya no la lee. En Vercel tampoco hace falta tocarla.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Supabase (Fase 1 en adelante)
# ---------------------------------------------------------------------------
# Supabase renombro el sistema de claves: la vieja "anon key" ahora es la
# publishable key (sb_publishable_...) y la vieja "service_role" es una secret
# key (sb_secret_...). Los NOMBRES DE VARIABLE se mantienen segun el plan v5 §6.
#
# Se sacan de: Supabase > Project Settings > API Keys

# URL del proyecto. Publica.
PUBLIC_SUPABASE_URL=

# publishable key (ex anon key). PUBLICA POR DISENO: viaja al browser.
# Lo que protege los datos NO es esta clave, es RLS.
# Cargar tambien en Vercel.
PUBLIC_SUPABASE_ANON_KEY=

# secret key (ex service_role key). SALTEA RLS POR COMPLETO.
# >>> SOLO para los scripts locales de migracion (scripts/migrate-data.mjs) <<<
# - NUNCA lleva prefijo PUBLIC_
# - NUNCA se importa desde un .astro sin prerender = false
# - NUNCA se carga en Vercel: el sitio no la necesita
# Si esta clave se filtra, cualquiera puede leer y escribir toda la base,
# incluida la tabla privada property_notes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Diagnostico (opcional)
# ---------------------------------------------------------------------------
# DEBUG_SUPABASE=1 loguea, al arrancar la funcion, de donde salio cada credencial
# (del build o del runtime) y como se ve la publishable key: su largo y sus
# primeros y ultimos 4 caracteres. Con eso se detecta un caracter mal tipeado, un
# recorte o un espacio pegado, sin exponer la clave.
#
# Existe por un incidente real de la Fase 3: la key cargada en Vercel tenia "Ql"
# (ele minuscula) en vez de "QI" (i mayuscula). Supabase respondia "Invalid API
# key", el sitio caia al fallback y PARECIA andar, asi que costo tres redeploys
# encontrarlo.
#
# Sin prefijo PUBLIC_ a proposito: se lee de process.env en runtime, asi que
# alcanza con redeployar para prenderlo, y nunca viaja al browser.
#
# Dejar vacio o sin definir en condiciones normales.
DEBUG_SUPABASE=

# ---------------------------------------------------------------------------
# CARTO — clave de los tiles de los mapas
#
# CARTO empezo a exigir una clave gratuita para servir los tiles de fondo. Sin
# ella los mapas se ven con un cartel de "API KEY REQUIRED" encima.
#
# Lleva prefijo PUBLIC_ porque viaja dentro de la URL del tile, que la pide el
# browser: es publica por diseno y no protege nada.
#
# >>> IMPORTANTE <<<
# Esta variable hay que cargarla TAMBIEN en Vercel:
#   Project Settings > Environment Variables > PUBLIC_CARTO_API_KEY
# aplicandola a Production, Preview y Development.
# Las PUBLIC_* se incrustan en tiempo de BUILD: si falta en Vercel, los mapas
# andan en local y fallan en produccion. Es el mismo patron que ya paso con las
# claves de Supabase.
#
# La usan los CUATRO mapas del proyecto, todos a traves de src/lib/mapa-tiles.ts:
#   - el de resultados de /busqueda (estilo oscuro)
#   - el de la ficha de propiedad
#   - el mismo en pantalla completa
#   - el del panel, para ubicar una propiedad
#
# OJO: CARTO avisó que va a retirar este servicio de tiles rasterizados, sin dar
# fecha. Ver el §12 del plan.
PUBLIC_CARTO_API_KEY=
